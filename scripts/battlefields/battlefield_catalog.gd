extends RefCounted

## RL BATTLEFIELD SET (scenario DATA only).
##
## Loads the ten canonical battlefields of the RL set `rl_canonical_v1` from
## res://data/battlefields/rl_canonical_v1/*.json. They are kept apart from
## future hand-built battlefields and are reachable in-game only from the DEV
## map collection window (scripts/ui/dev_map_collection_panel.gd).
## A battlefield is pure map data interpreted by the existing rules: terrain
## per cell (existing HexCell terrain ids), river cells (a bridge is a road
## cell that is also a river cell, the existing semantics), strongholds
## (existing FORTRESS / CAPITAL types) and the opening deployment. Nothing
## here changes how movement, combat, fog, AI or turns interpret a map.
##
## The JSON files are generated by tools/battlefields/build_canonical_battlefields.py.
## Const/static only and deliberately without class_name (preload it).
##
## Selection: Step2RBattlefieldShell.battlefield_id, the command-line arg
## --battlefield=<ID>, or pending_id (set by the DEV map collection window;
## the title screen resets it on entry). All empty = the default production
## map, unchanged.

const FORMAT: String = "canonical_battlefield_v1"
const SET_ID: String = "rl_canonical_v1"
const SET_TITLE: String = "RL 전장 세트 (RL battlefields, canonical v1)"
const DATA_DIR: String = "res://data/battlefields/rl_canonical_v1/"
const FILES: Dictionary = {
	"BF01": "bf01_open_plain.json",
	"BF02": "bf02_forest_edge.json",
	"BF03": "bf03_deep_forest.json",
	"BF04": "bf04_mountain_pass.json",
	"BF05": "bf05_ridge_valley.json",
	"BF06": "bf06_river_crossing.json",
	"BF07": "bf07_fortified_approach.json",
	"BF08": "bf08_basin_trap.json",
	"BF09": "bf09_split_front.json",
	"BF10": "bf10_mixed_frontier.json",
}
## Row alphabet -> existing HexCell.TerrainType ids. 'B' is a bridge: a road
## cell (6) that is also a river cell.
const LEGEND: Dictionary = {
	".": 0, "M": 1, "F": 2, "S": 3, "V": 5, "R": 6, "B": 6, "W": 7, "X": 9, "C": 11,
}
const RIVER_CHARS: String = "WB"

## DEV map-window selection for the next shell instance ("" = default map).
static var pending_id: String = ""

static func ids() -> Array:
	var out: Array = FILES.keys()
	out.sort()
	return out

static func has_battlefield(id: String) -> bool:
	return FILES.has(id.to_upper())

## Display title for menus ("BF01  Open Plain  河北平原"); "" if unknown.
static func title_of(id: String) -> String:
	var d: Dictionary = _read(id)
	if d.is_empty():
		return ""
	return "%s  %s  %s" % [id.to_upper(), str(d.get("name", "")), str(d.get("name_zh", ""))]

## Menu row data for one battlefield ({} if unknown): id, name, name_zh,
## terrain / tactical / asymmetry text, unit counts, stronghold names.
static func summary_of(id: String) -> Dictionary:
	var d: Dictionary = _read(id)
	if d.is_empty():
		return {}
	var info: Dictionary = d.get("info", {})
	var sh: Array = []
	for s in d.get("strongholds", []):
		sh.append(str(s.get("name", s.get("id", ""))))
	return {
		"id": id.to_upper(), "name": str(d.get("name", "")), "name_zh": str(d.get("name_zh", "")),
		"terrain": str(info.get("terrain", "")), "tactical": str(info.get("tactical", "")),
		"asymmetry": str(info.get("asymmetry", "")), "units": info.get("units", {}),
		"strongholds": sh,
	}

## Resolves the requested id: explicit export first, then --battlefield=<ID>,
## then pending_id. Returns "" for the default map.
static func resolve_requested_id(explicit_id: String) -> String:
	if explicit_id.begins_with("@"):  # a generated mission map file ("@<path>", 2026-10-09): keep the path's case
		return explicit_id
	if not explicit_id.is_empty():
		return explicit_id.to_upper()
	for arg in OS.get_cmdline_user_args():
		if str(arg).begins_with("--battlefield="):
			return str(arg).substr(14).to_upper()
	for arg in OS.get_cmdline_args():
		if str(arg).begins_with("--battlefield="):
			return str(arg).substr(14).to_upper()
	return pending_id.to_upper()

static func _read(id: String) -> Dictionary:
	var key: String = id.to_upper()
	if not FILES.has(key):
		return {}
	var path: String = DATA_DIR + str(FILES[key])
	var f: FileAccess = FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("[Battlefield] cannot open %s" % path)
		return {}
	var parsed: Variant = JSON.parse_string(f.get_as_text())
	f.close()
	if not (parsed is Dictionary) or str((parsed as Dictionary).get("format", "")) != FORMAT:
		push_error("[Battlefield] %s is not %s" % [path, FORMAT])
		return {}
	if str((parsed as Dictionary).get("set", "")) != SET_ID:
		push_error("[Battlefield] %s does not belong to set %s" % [path, SET_ID])
		return {}
	return parsed

## Returns {} on any failure (the shell then falls back to the default map).
## Keys: id, name, name_zh, terrain ("q,r" -> int), river ("q,r" -> true),
## strongholds (Array of {id, name, type, owner, footprint: Array[Vector2i],
## anchor, hp, slots}), units (Array of {id, class, faction, q, r, count}).
static func load_battlefield(id: String) -> Dictionary:
	var key: String = id.to_upper()
	if not FILES.has(key):
		push_error("[Battlefield] unknown battlefield id '%s'" % id)
		return {}
	var src: Dictionary = _read(key)
	if src.is_empty():
		return {}
	var q_min: int = int(src.get("q_min", -40))
	var r_min: int = int(src.get("r_min", -40))
	var terrain: Dictionary = {}
	var river: Dictionary = {}
	var rows: Array = src.get("rows", [])
	for i in range(rows.size()):
		var row: String = str(rows[i])
		var q: int = q_min + i
		for j in range(row.length()):
			var ch: String = row[j]
			if ch == " ":
				continue
			if not LEGEND.has(ch):
				push_error("[Battlefield] %s: bad terrain char '%s'" % [key, ch])
				return {}
			var k: String = "%d,%d" % [q, r_min + j]
			terrain[k] = int(LEGEND[ch])
			if RIVER_CHARS.contains(ch):
				river[k] = true
	var strongholds: Array = []
	for s in src.get("strongholds", []):
		var fp: Array[Vector2i] = []
		for h in s.get("footprint", []):
			fp.append(Vector2i(int(h[0]), int(h[1])))
		if fp.is_empty():
			continue
		strongholds.append({
			"id": str(s.get("id", "")),
			"name": str(s.get("name", s.get("id", ""))),
			"type": str(s.get("type", "fortress")),
			"owner": str(s.get("owner", "red")),
			"footprint": fp,
			"anchor": fp[0],
			"hp": int(s.get("hp", 1000)),
			"slots": int(s.get("slots", 4)),
		})
	var units: Array = []
	for u in src.get("units", []):
		units.append({
			"id": str(u[0]), "class": str(u[1]), "faction": str(u[2]),
			"q": int(u[3]), "r": int(u[4]), "count": int(u[5]),
		})
	return {
		"id": key,
		"name": str(src.get("name", key)),
		"name_zh": str(src.get("name_zh", "")),
		"terrain": terrain,
		"river": river,
		"strongholds": strongholds,
		"units": units,
	}
