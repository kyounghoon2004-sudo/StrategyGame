class_name Step7AdvisorLLMSelector
extends Node

## Ollama-backed tactical selector for the Advisor pilot (ONE local model).
##
## Responsibilities ONLY:
##   construct Advisor messages -> POST via Step7OllamaAdvisorClient ->
##   parse + validate the structured recommendation -> stale-check against
##   live state -> emit recommendation or a player-safe failure.
##
## Owns NO legality, NO scoring, NO movement, NO execution. Model output is
## untrusted data: only the defined contract fields are accepted, and only
## when they resolve to supplied AVAILABLE/DEGRADED option ids.
##
## Signals:
##   recommendation_ready(request_id, recommendation{profile, slot,
##       confidence, reason, primary_risk, alternative_profile,
##       alternative_slot, alternative_reason, battlefield_assessment,
##       request_id, state_version, latency_ms, eval counts...})
##   recommendation_failed(request_id, code, player_message)
## Codes: OFFLINE, TIMEOUT, HTTP_ERROR, MODEL_MISSING, BAD_RESPONSE,
## INVALID_OPTION, MALFORMED, STALE (not emitted; stale is discarded
## silently with a DEV log line STALE_ADVISOR_RESPONSE_DISCARDED).

signal recommendation_ready(request_id: String, recommendation: Dictionary)
signal recommendation_failed(request_id: String, code: String, player_message: String)

const ClientScript = preload("res://scripts/step7/step7_ollama_client.gd")
const ConfigScript = preload("res://scripts/step7/step7_ollama_config.gd")
const BackendCfgScript = preload("res://scripts/ai/ai_backend_config.gd")
const ContextScript = preload("res://scripts/step7/step7_advisor_context.gd")
const ViewModelScript = preload("res://scripts/step7/step7_advisor_viewmodel.gd")

const VALID_PROFILES := ["SAFE", "SUPPORTED", "BALANCED", "PRESSURE", "DEEP", "MAXIMUM"]
const MAX_FIELD_CHARS := 1200

const SYSTEM_PROMPT := """You are Seo Yuseon (서유선), staff military advisor to the BLUE commander in a historical strategy battle (Hulao-Luoyang campaign). You speak to your commander in concise, professional Korean.

YOUR AUTHORITY
- You are an ADVISOR and SELECTOR only. You do not command troops, move units, resolve combat, or know anything beyond the snapshot supplied below.
- Six tactical options have been generated by a deterministic evaluator that OWNS legality: every AVAILABLE or DEGRADED option is legal to execute. UNAVAILABLE options are not executable.
- Recommend EXACTLY ONE supplied option by its id. Never invent a new action, destination, unit, or enemy. Never output coordinates or paths of your own.

BATTLE RULES (terminal, both sides)
- Own HQ destroyed = immediate defeat; enemy HQ destroyed = immediate victory. The battle ends at once either way.
- Weigh HQ survival and decisive HQ kills above ordinary preservation: never preserve a formation at the cost of defeat, never waste formations pointlessly.

FOG OF WAR
- Only the contacts listed under authorized_enemy_knowledge exist for you. Current-visible contacts are reliable; stale_last_known contacts may have moved — treat them as uncertain, never as current facts.
- Never assert enemy facts (locations, classes, strengths, intentions) that are not in the snapshot. If information is thin, say so and weigh the uncertainty explicitly.
- Name units ONLY with the exact identifier strings given in the snapshot (the _supplied_ids list). NEVER write any other identifier in XX_YY form (for example, never invent R_CAV_2, R_INF_5, or similar): refer to unnamed forces only as generic "enemy"/"friendly" formations. An invented precise id is worse than a vague truth.

JUDGMENT
- Each option carries the evaluator's utility score and feature contributions. That score is EVIDENCE, not a command: you may disagree with the highest-utility option when mission, risk, support, mobility, retreat safety, supply, or uncertainty argue otherwise — but then explain why.
- Weigh, in order of the commander's interest: the current ADVANCE intent (choose HOW to realize it; warn if the intent itself looks dangerous but stay within the supplied options), formation preservation, support/cohesion with nearby friendlies, counter-risk from known contacts, future mobility and retreat geometry, and pressure on the enemy.
- A DEGRADED option is executable with a stated limitation; prefer a clean AVAILABLE option unless the degraded one's advantage clearly outweighs its limitation.

OUTPUT CONTRACT
- Return JSON ONLY — one object, no prose, no markdown fences, no commentary.
- Schema: {"recommended_option_id": "PRESSURE", "confidence": 0.78, "reason": "...", "primary_risk": "...", "alternative_option_id": "SUPPORTED", "alternative_reason": "...", "battlefield_assessment": "..."}
- recommended_option_id MUST be one of the supplied option ids and MUST NOT be an UNAVAILABLE option.
- confidence is a number 0.0-1.0.
- reason, primary_risk, alternative_reason, battlefield_assessment are natural Korean, each under 400 characters. Option ids stay as English tokens.
- alternative_option_id may be "" only if no alternative is worth naming."""

const REPAIR_TEMPLATE := """Your previous response was invalid: %s. The valid option ids are [%s]. %s. Return valid JSON only, exactly matching the schema, with recommended_option_id set to one of the valid ids that is not UNAVAILABLE."""

var state_provider := Callable() # () -> {unit_id, state_version, fingerprint}
var _client = null # Step7OllamaAdvisorClient
var _active := {} # request_id -> {snapshot, available, valid_ids, payload_text, repair_used, sent_msec, config}
var _debug := {} # last-request DEV diagnostics


func _ready() -> void:
	_client = ClientScript.new()
	_client.name = "OllamaAdvisorClient"
	add_child(_client)
	_client.chat_finished.connect(_on_chat_finished)


func has_active() -> bool:
	return not _active.is_empty()


func active_request_id() -> String:
	if _active.is_empty():
		return ""
	return str((_active.keys() as Array)[0])


## Begin one Advisor inference over a built context. snapshot =
## {unit_id, state_version, fingerprint}. context/audit come from
## Step7AdvisorContext.build(). slot_of maps profile -> option slot.
func advise(request_id: String, context: Dictionary, snapshot: Dictionary,
		slot_of: Dictionary, available_ids: Array) -> Dictionary:
	if context.is_empty():
		return {"ok": false, "code": "MALFORMED", "detail": "Empty context."}
	cancel()
	var messages := [
		{"role": "system", "content": SYSTEM_PROMPT},
		{"role": "user", "content": "TACTICAL_SNAPSHOT_JSON:\n" + JSON.stringify(context)},
	]
	# Single runtime authority: AIBackendConfig is the ONLY writer of the
	# endpoint/model ProjectSettings keys this describe() call reads, so
	# cfg["endpoint"] (chat URL) and cfg["model"] are already the exact
	# player-selected values. Generation-shape defaults
	# (temperature/num_ctx/...) stay in Step7OllamaConfig. Only the
	# backend label, config identity, and key-presence flag are merged in.
	var authority := BackendCfgScript.current()
	var cfg := ConfigScript.describe()
	cfg["backend_type"] = str(authority.get("backend_type", cfg.get("backend_type", "")))
	cfg["config_identity"] = str(authority.get("config_identity", cfg.get("config_identity", "")))
	cfg["api_key_present"] = bool(authority.get("api_key_present", false))
	_active[request_id] = {
		"snapshot": snapshot.duplicate(true),
		"slot_of": slot_of.duplicate(true),
		"available": available_ids.duplicate(),
		"valid_ids": VALID_PROFILES.duplicate(),
		"context": context,
		"repair_used": false,
		"sent_msec": Time.get_ticks_msec(),
		"config": cfg,
		"config_identity": str(cfg.get("config_identity", "")),
	}
	_debug = {
		"request_id": request_id, "model": str(cfg.get("model", "?")),
		"endpoint": str(cfg.get("endpoint", "?")),
		"backend_type": str(cfg.get("backend_type", "?")),
		"config_identity": str(cfg.get("config_identity", "")),
		"api_key_present": bool(cfg.get("api_key_present", false)),
		"sent_msec": int(_active[request_id]["sent_msec"]),
		"state_version": int(snapshot.get("state_version", -1)),
		"fingerprint": str(snapshot.get("fingerprint", "")),
		"option_fingerprint": str(((context.get("state_identity", {}) as Dictionary).get("option_package_fingerprint", ""))),
		"payload_chars": ("TACTICAL_SNAPSHOT_JSON:\n" + JSON.stringify(context)).length(),
		"payload": context,
		"raw_content": "", "parsed": {}, "http_status": 0,
		"latency_ms": 0, "prompt_eval_count": 0, "eval_count": 0,
		"prompt_eval_duration_ns": 0, "eval_duration_ns": 0,
		"total_duration_ns": 0, "load_duration_ns": 0,
		"failure": "", "stale_discarded": false,
		"hallucination_flags": [],
	}
	# Memory-only secret: header transport only, never stored or logged.
	var api_key := BackendCfgScript.get_api_key()
	var started: Dictionary = _client.request_chat(request_id,
		str(cfg.get("endpoint", "")), str(cfg.get("model", "")),
		messages, cfg.get("options", {}), float(cfg.get("timeout_seconds", 120.0)),
		api_key)
	if not bool(started.get("ok", false)):
		_debug["failure"] = "%s: %s" % [str(started.get("code", "OFFLINE")), str(started.get("detail", ""))]
		_active.clear()
		return {"ok": false, "code": str(started.get("code", "OFFLINE")),
			"detail": str(started.get("detail", ""))}
	return {"ok": true, "request_id": request_id}


func cancel() -> void:
	if _client != null and _client.has_method("cancel_active"):
		_client.cancel_active()
	_active.clear()


func debug_snapshot() -> Dictionary:
	return _debug.duplicate(true)


func _current_snapshot() -> Dictionary:
	if state_provider.is_valid():
		var s: Variant = state_provider.call()
		if s is Dictionary:
			return s
	return {}


func _config_stale(stored_identity: String) -> bool:
	if stored_identity.strip_edges().is_empty():
		return false # legacy entry without identity: accept.
	return BackendCfgScript.config_identity() != stored_identity


func _is_stale(stored: Dictionary) -> bool:
	var cur := _current_snapshot()
	if cur.is_empty():
		return false # no live source (tests): accept.
	return str(cur.get("unit_id", "")) != str(stored.get("unit_id", "")) \
		or int(cur.get("state_version", -2)) != int(stored.get("state_version", -1)) \
		or str(cur.get("fingerprint", "")) != str(stored.get("fingerprint", ""))


## Full staleness: battle snapshot drift OR backend-config drift (the user
## switched endpoint/model/backend while this request was in flight).
## Old-model responses must never surface as current advice.
func _is_stale_entry(entry: Dictionary) -> bool:
	if _is_stale(entry.get("snapshot", {})):
		return true
	return _config_stale(str(entry.get("config_identity", "")))


func _on_chat_finished(request_id: String, result: Dictionary) -> void:
	if not _active.has(request_id):
		return # superseded/cancelled: discard silently.
	var entry: Dictionary = _active[request_id]
	if not bool(result.get("ok", false)):
		_debug["http_status"] = int(result.get("http_status", 0))
		_debug["latency_ms"] = int(result.get("latency_ms", 0))
		_debug["failure"] = "%s: %s" % [str(result.get("code", "?")), str(result.get("detail", ""))]
		_active.erase(request_id)
		recommendation_failed.emit(request_id, str(result.get("code", "OFFLINE")),
			_player_message_for(str(result.get("code", "OFFLINE"))))
		return
	_debug["http_status"] = int(result.get("http_status", 0))
	_debug["latency_ms"] = int(result.get("latency_ms", 0))
	_debug["raw_content"] = str(result.get("content_text", ""))
	_debug["prompt_eval_count"] = int(result.get("prompt_eval_count", 0))
	_debug["eval_count"] = int(result.get("eval_count", 0))
	_debug["prompt_eval_duration_ns"] = int(result.get("prompt_eval_duration_ns", 0))
	_debug["eval_duration_ns"] = int(result.get("eval_duration_ns", 0))
	_debug["total_duration_ns"] = int(result.get("total_duration_ns", 0))
	_debug["load_duration_ns"] = int(result.get("load_duration_ns", 0))
	# Stale check FIRST: never display or repair against an old battle
	# state OR an outdated backend config (model switched mid-flight).
	if _is_stale_entry(entry):
		_debug["stale_discarded"] = true
		_active.erase(request_id)
		print("[AdvisorLLM] STALE_ADVISOR_RESPONSE_DISCARDED request=%s" % request_id)
		return
	var parsed := _extract_json(str(result.get("content_text", "")))
	if parsed.is_empty():
		_attempt_repair_or_fail(request_id, entry, "response contained no parseable JSON object")
		return
	_debug["parsed"] = (parsed as Dictionary).duplicate(true)
	var checked := _validate(parsed, entry)
	if not bool(checked.get("ok", false)):
		_attempt_repair_or_fail(request_id, entry, str(checked.get("why", "invalid recommendation")))
		return
	_finalize_recommendation(request_id, entry, parsed, result)


func _attempt_repair_or_fail(request_id: String, entry: Dictionary, why: String) -> void:
	# Never repair against drifted state: a repaired request would reason
	# (or re-send) under an outdated snapshot/config identity.
	if _is_stale_entry(entry):
		_debug["stale_discarded"] = true
		_active.erase(request_id)
		print("[AdvisorLLM] STALE_ADVISOR_RESPONSE_DISCARDED request=%s (repair suppressed)" % request_id)
		return
	if bool(entry.get("repair_used", false)):
		_debug["failure"] = "repair failed: %s" % why
		_active.erase(request_id)
		recommendation_failed.emit(request_id, "MALFORMED",
			"자문 서신이 흐트러져 이번에는 정리를 내놓지 못하겠습니다. 여섯 안 중 하나를 직접 고르십시오.")
		return
	entry["repair_used"] = true
	_active[request_id] = entry
	var avail: Array = entry.get("available", [])
	var unavail: Array = []
	for p in VALID_PROFILES:
		if not p in avail:
			unavail.append(p)
	var extra := ""
	if not unavail.is_empty():
		extra = "Do not choose [%s] (UNAVAILABLE)" % ", ".join(unavail)
	var repair_msg := REPAIR_TEMPLATE % [why, ", ".join(VALID_PROFILES), extra]
	# Repair reuses the STORED request config (same model/endpoint) — never
	# the live authority — so a repaired response still matches its entry.
	var cfg: Dictionary = entry.get("config", ConfigScript.describe())
	var messages := [
		{"role": "system", "content": SYSTEM_PROMPT},
		{"role": "user", "content": repair_msg},
	]
	var started: Dictionary = _client.request_chat(request_id,
		str(cfg.get("endpoint", "")), str(cfg.get("model", "")),
		messages, cfg.get("options", {}), float(cfg.get("timeout_seconds", 120.0)),
		BackendCfgScript.get_api_key())
	if not bool(started.get("ok", false)):
		_debug["failure"] = "repair send failed: %s" % str(started.get("detail", ""))
		_active.erase(request_id)
		recommendation_failed.emit(request_id, str(started.get("code", "OFFLINE")),
			_player_message_for(str(started.get("code", "OFFLINE"))))


## Defensive single-JSON-object extraction (no natural-language parser).
static func _extract_json(text: String) -> Dictionary:
	var t := text.strip_edges()
	if t.begins_with("```"):
		var nl := t.find("\n")
		t = t.substr(nl + 1) if nl >= 0 else ""
		var fence := t.rfind("```")
		if fence >= 0:
			t = t.substr(0, fence)
		t = t.strip_edges()
	var parsed: Variant = JSON.parse_string(t)
	if parsed is Dictionary:
		return parsed
	var start := t.find("{")
	var stop := t.rfind("}")
	if start >= 0 and stop > start:
		var inner: Variant = JSON.parse_string(t.substr(start, stop - start + 1))
		if inner is Dictionary:
			return inner
	return {}


func _validate(rec: Dictionary, entry: Dictionary) -> Dictionary:
	for key in ["recommended_option_id", "confidence", "reason",
			"primary_risk", "alternative_option_id", "alternative_reason",
			"battlefield_assessment"]:
		if not rec.has(key):
			return {"ok": false, "why": "missing key '%s'" % key}
	var pick := str(rec.get("recommended_option_id", "")).strip_edges().to_upper()
	if not pick in VALID_PROFILES:
		return {"ok": false, "why": "recommended_option_id '%s' is not one of [%s]" % [str(rec.get("recommended_option_id", "")), ", ".join(VALID_PROFILES)]}
	if not pick in (entry.get("available", []) as Array):
		return {"ok": false, "why": "recommended_option_id '%s' is UNAVAILABLE in the current package" % pick}
	var conf := float(rec.get("confidence", -1.0))
	if conf < 0.0 or conf > 1.0:
		return {"ok": false, "why": "confidence %.3f outside 0.0-1.0" % conf}
	for key in ["reason", "primary_risk", "alternative_reason", "battlefield_assessment"]:
		var s := str(rec.get(key, ""))
		if s.strip_edges().is_empty() and key != "alternative_reason":
			return {"ok": false, "why": "'%s' is empty" % key}
		if s.length() > MAX_FIELD_CHARS:
			return {"ok": false, "why": "'%s' exceeds %d chars" % [key, MAX_FIELD_CHARS]}
	var alt := str(rec.get("alternative_option_id", "")).strip_edges().to_upper()
	if not alt.is_empty():
		if not alt in VALID_PROFILES:
			return {"ok": false, "why": "alternative_option_id '%s' is not a valid option" % str(rec.get("alternative_option_id", ""))}
		if not alt in (entry.get("available", []) as Array):
			return {"ok": false, "why": "alternative_option_id '%s' is UNAVAILABLE" % alt}
		if alt == pick:
			return {"ok": false, "why": "alternative duplicates the recommendation"}
	var echo := str(rec.get("request_id", "")).strip_edges()
	if not echo.is_empty() and echo != active_request_id():
		return {"ok": false, "why": "request identity mismatch"}
	return {"ok": true, "pick": pick, "alternative": alt, "confidence": conf}


func _finalize_recommendation(request_id: String, entry: Dictionary,
		rec: Dictionary, transport: Dictionary) -> void:
	# Re-check staleness after validation (state or config may have moved).
	if _is_stale_entry(entry):
		_debug["stale_discarded"] = true
		_active.erase(request_id)
		print("[AdvisorLLM] STALE_ADVISOR_RESPONSE_DISCARDED request=%s" % request_id)
		return
	var slot_of: Dictionary = entry.get("slot_of", {})
	var pick := str(rec.get("recommended_option_id", "")).strip_edges().to_upper()
	var alt := str(rec.get("alternative_option_id", "")).strip_edges().to_upper()
	var supplied: Array = ContextScript.supplied_contact_ids(
		entry.get("context", {}))
	_debug["hallucination_flags"] = _screen_hallucinations(rec, supplied)
	# Display sanitizer (defense in depth): precise-looking invented ids
	# never reach the player; generics replace them. Counts stay in DEV.
	var clean := (rec as Dictionary).duplicate()
	var redacted_total := 0
	for key in ["reason", "primary_risk", "alternative_reason", "battlefield_assessment"]:
		var s: Dictionary = ViewModelScript.sanitize_advisor_text(str(rec.get(key, "")), supplied)
		clean[key] = str(s.get("text", ""))
		redacted_total += (s.get("redactions", []) as Array).size()
	_debug["redactions"] = redacted_total
	if redacted_total > 0:
		print("[AdvisorLLM] display sanitizer redacted %d unsupplied id(s) for request=%s" % [redacted_total, request_id])
	_active.erase(request_id)
	var entry_cfg: Dictionary = entry.get("config", {})
	recommendation_ready.emit(request_id, {
		"profile": pick, "slot": int(slot_of.get(pick, 0)),
		"model": str(entry_cfg.get("model", "?")),
		"config_identity": str(entry.get("config_identity", "")),
		"confidence": float(rec.get("confidence", 0.0)),
		"reason": str(clean.get("reason", "")),
		"primary_risk": str(clean.get("primary_risk", "")),
		"alternative_profile": alt,
		"alternative_slot": int(slot_of.get(alt, 0)) if not alt.is_empty() else 0,
		"alternative_reason": str(clean.get("alternative_reason", "")),
		"battlefield_assessment": str(clean.get("battlefield_assessment", "")),
		"request_id": request_id,
		"state_version": int((entry.get("snapshot", {}) as Dictionary).get("state_version", -1)),
		"latency_ms": int(transport.get("latency_ms", 0)),
		"prompt_eval_count": int(transport.get("prompt_eval_count", 0)),
		"eval_count": int(transport.get("eval_count", 0)),
	})


## Flag (never act on) id-like tokens in model prose that were never
## supplied: possible hallucinated units/contacts. Doctrine vocabulary
## (features, profiles) is excluded. DEV diagnostics only.
func _screen_hallucinations(rec: Dictionary, supplied: Array) -> Array:
	var vocab := {}
	for v in ViewModelScript.ADVISOR_SAFE_VOCAB:
		vocab[str(v)] = true
	var flags: Array = []
	var prose := "%s\n%s\n%s\n%s" % [str(rec.get("reason", "")),
		str(rec.get("primary_risk", "")), str(rec.get("alternative_reason", "")),
		str(rec.get("battlefield_assessment", ""))]
	var re := RegEx.new()
	re.compile("\\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\\b")
	for m in re.search_all(prose):
		var tok := m.get_string()
		if vocab.has(tok):
			continue
		if not tok in supplied and not tok in flags:
			flags.append(tok)
	if not flags.is_empty():
		print("[AdvisorLLM] hallucination screen flags (not supplied): %s" % ", ".join(flags))
	return flags


func _player_message_for(code: String) -> String:
	match code:
		"OFFLINE", "TIMEOUT":
			return "현재 전술 자문 모델에 연결할 수 없습니다. 여섯 가지 안은 그대로 고르실 수 있습니다."
		"MODEL_MISSING":
			return "자문 모델을 찾을 수 없습니다. 여섯 가지 안은 그대로 고르실 수 있습니다."
		_:
			return "자문을 받아오지 못했습니다. 여섯 가지 안은 그대로 고르실 수 있습니다."
